# --- 必須 ---
# ログイン用パスワードと Cookie 署名用の秘密鍵（openssl rand -base64 32 などで生成）
APP_PASSWORD=
AUTH_SECRET=

# Neon Postgres（Vercel Marketplace で作成すると自動で入る）
DATABASE_URL=

# 会話: OpenAI Realtime API
OPENAI_API_KEY=
# 会話後の分析: Claude API
ANTHROPIC_API_KEY=

# --- 任意（未設定なら発音評価なしで動く） ---
# Azure AI Speech（prosody 評価に対応するリージョン, 例: eastus）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- 調整 ---
MONTHLY_BUDGET_JPY=3000
USD_JPY=150
SESSION_MAX_MINUTES=15
